# Copy to .env (never commit .env). Every setting in configs/default.yaml can be
# overridden here with CLAIMCHECK_<SECTION>__<KEY>, e.g. CLAIMCHECK_RETRIEVAL__TOP_K=10.

CLAIMCHECK_ENV=dev
# CLAIMCHECK_CONFIG=configs/default.yaml

# LLM provider API keys. Each provider in configs/default.yaml names its variable
# via `api_key_env` (GROQ_API_KEY, GEMINI_API_KEY). Not needed in fake mode:
# CLAIMCHECK_FAKE_LLM=1 gives canned answers with no provider calls.
# EXAMPLE_API_KEY=

# Optional: Hugging Face token for model downloads / artifact publishing.
# HF_TOKEN=
